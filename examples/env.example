# SIGNAL demo environment template — NEVER commit real credentials
NODE_ENV=development
NEXT_PUBLIC_SIGNAL_APP_NAME=SIGNAL

# App session signing: minimum 32 random bytes; server-only
APP_SESSION_SECRET=replace-with-strong-random-secret
DEMO_OPERATOR_LOGIN_SECRET=replace-for-demo-only

# LLM: choose provider and model at runtime
OPENAI_API_KEY=replace-me
AI_MODEL=select-a-supported-model

# SurrealDB Core — operational tables
SURREALDB_URL=wss://your-surrealdb-core-instance
SURREALDB_NAMESPACE=signal
SURREALDB_DATABASE=demo
SURREALDB_USERNAME=replace-me
SURREALDB_PASSWORD=replace-me

# SurrealDB Agent Memory — exact host/context from SurrealDB Studio
AGENT_MEMORY_ENDPOINT=https://your-actual-context-host
AGENT_MEMORY_CONTEXT_ID=signal-dev
AGENT_MEMORY_API_KEY=replace-me
AGENT_MEMORY_SCOPE=org/signal/site/demo/location/room204

# Anchor Browser — current SDK commonly uses ANCHORBROWSER_API_KEY
ANCHORBROWSER_API_KEY=replace-me
MAINTENANCE_PORTAL_BASE_URL=https://your-app.vercel.app/demo/maintenance

# Arize Phoenix
PHOENIX_COLLECTOR_ENDPOINT=https://your-phoenix-collector
PHOENIX_API_KEY=replace-me
PHOENIX_PROJECT=signal-hackathon

# ElevenLabs
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_AGENT_ID=replace-me
ELEVENLABS_AGENT_PHONE_NUMBER_ID=replace-me
DEMO_APPROVED_PHONE_E164=+15555550123

# NFC — don't store the AES tag key itself in this file in production
NFC_KEY_STORE_REF=demo-key-id-only
NFC_MODE=verified # or 'simulated' with prominent UI disclosure

# Feature flags — disable high-impact tools until audited/approved
ENABLE_REAL_NFC_VERIFICATION=false
ENABLE_ANCHOR_ACTIONS=false
ENABLE_OUTBOUND_CALLS=false
