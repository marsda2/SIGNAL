# SIGNAL environment template. Copy to .env.local and fill in. NEVER put real values in this file.
# All variables are server-only (used by src/app/api/** routes). Nothing here may be prefixed
# with EXPO_PUBLIC_ — that would ship it to every visitor's browser.

# --- App ---
APP_SESSION_SECRET=              # >= 32 random bytes
DEMO_OPERATOR_LOGIN_SECRET=      # guards /api/demo/* and /api/memory/seed

# --- LLM (Vercel AI SDK). Anthropic is wired by default; swap provider in src/lib/agent/model.ts ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- SurrealDB Agent Memory (host + context id + scoped key from SurrealDB Studio) ---
AGENT_MEMORY_ENDPOINT=           # e.g. https://srv1.<region>.surreal.cloud  (no /mcp, no trailing slash)
AGENT_MEMORY_CONTEXT_ID=
AGENT_MEMORY_API_KEY=

# --- SurrealDB Core (operational incidents) — not wired yet, see docs/09_EXPO_STACK.md ---
SURREALDB_URL=
SURREALDB_NAMESPACE=signal
SURREALDB_DATABASE=demo
SURREALDB_USERNAME=
SURREALDB_PASSWORD=

# --- Daytona (dev sandbox + smoke tests) ---
DAYTONA_API_KEY=

# --- Anchor Browser ---
ANCHORBROWSER_API_KEY=
MAINTENANCE_PORTAL_BASE_URL=http://localhost:8081/demo/maintenance

# --- ElevenLabs (cached mascot cues + later outbound calls) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
DEMO_APPROVED_PHONE_E164=

# --- Twilio (future; ElevenLabs outbound calls use a Twilio number imported into ElevenLabs) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Arize Phoenix ---
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT=signal-hackathon

# --- NFC ---
NFC_MODE=simulated               # 'simulated' (UI shows DEMO banner) or 'verified'
NFC_KEY_STORE_REF=               # key *reference* only, never the AES key
NFC_SDM_META_KEY=                # 32 hex. Blank = factory zeros (bring-up only; forgeable). See docs/10_NFC_SETUP.md
NFC_SDM_FILE_KEY=                # 32 hex. Blank = factory zeros
NFC_TAGS=                        # chip UID -> location, e.g. 04DE5F1EACC040=room204,04AABBCCDDEE11=room205

# --- Feature flags: high-impact tools stay off until audited ---
ENABLE_ANCHOR_ACTIONS=false
ENABLE_OUTBOUND_CALLS=false
